# Copy to .env on your own device/server. Never commit .env.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
AI_HUB_PROVIDER_TIMEOUT_SECONDS=30

# Installation/client authentication. Store SHA-256 hashes only, never raw tokens.
AI_HUB_CLIENTS_JSON=[]

# Central product-level AI policy / kill switch.
# Example Coach:
# [{"product_id":"coach","ai_enabled":true,"ai_mode":"AUTO","allowed_profiles":["coach-understanding"]}]
AI_HUB_PRODUCTS_JSON=[]

# Paid/trial AI entitlement per license + product.
# Example:
# [{"license_id":"COACH-001","product_id":"coach","plan":"COACH_AI_MONTHLY","ai_enabled":true,
#   "expires_at":"2026-12-31T23:59:59Z","monthly_token_quota":200000}]
AI_HUB_ENTITLEMENTS_JSON=[]

# Browser origins allowed to call AI Hub. Local Coach HTML sends Origin: null.
# For production, add only the exact HTTPS origin(s) that host MEasyMate products.
AI_HUB_CORS_ORIGINS_JSON=["null"]
