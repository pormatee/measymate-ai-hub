# Copy to .env on your own device/server. Never commit .env.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
AI_HUB_PROVIDER_TIMEOUT_SECONDS=30

# JSON array of client policies. Store token SHA-256 hashes only, never raw client tokens.
AI_HUB_CLIENTS_JSON=[]
